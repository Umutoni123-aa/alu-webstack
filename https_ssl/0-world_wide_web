#!/usr/bin/env bash
# Display information about subdomains

get_subdomain_info() {
    local domain=$1
    local subdomain=$2
    local full_domain="${subdomain}.${domain}"
    
    # Use dig to get DNS information and awk to parse it
    local result=$(dig "$full_domain" | grep -A1 'ANSWER SECTION:' | tail -n1)
    
    if [ -n "$result" ]; then
        local record_type=$(echo "$result" | awk '{print $4}')
        local destination=$(echo "$result" | awk '{print $5}')
        echo "The subdomain $subdomain is a $record_type record and points to $destination"
    fi
}

# Main logic
domain=$1
subdomain=$2

if [ -z "$subdomain" ]; then
    # No subdomain provided, check all default subdomains
    get_subdomain_info "$domain" "www"
    get_subdomain_info "$domain" "lb-01"
    get_subdomain_info "$domain" "web-01"
    get_subdomain_info "$domain" "web-02"
else
    # Specific subdomain provided
    get_subdomain_info "$domain" "$subdomain"
fi

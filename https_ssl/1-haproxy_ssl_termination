global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn 2048
    tune.ssl.default-dh-param 2048

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend www-https
    bind *:443 ssl crt /etc/haproxy/certs/umutoni-www.duckdns.org.pem
    reqadd X-Forwarded-Proto:\ https
    default_backend web-backend

backend web-backend
    balance roundrobin
    server web-01 44.203.40.15:80 check
    server web-02 13.221.14.191:80 check
